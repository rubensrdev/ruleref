{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(./init.sh)",
      "Bash(./init.sh *)",
      "Bash(xcodebuild -list *)",
      "Bash(xcodebuild build *)",
      "Bash(xcodebuild test *)",
      "Bash(xcodebuild build-for-testing *)",
      "Bash(xcodebuild test-without-building *)",
      "Bash(xcrun simctl list *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "mcp__cupertino__*",
      "mcp__xcode__XcodeListWorkspaces",
      "mcp__xcode__XcodeOpenWorkspace",
      "mcp__xcode__XcodeCloseWorkspace",
      "mcp__xcode__XcodeRead",
      "mcp__xcode__XcodeGlob",
      "mcp__xcode__XcodeGrep",
      "mcp__xcode__XcodeLS",
      "mcp__xcode__XcodeListRunDestinations",
      "mcp__xcode__XcodeListSchemes",
      "mcp__xcode__XcodeListTargets",
      "mcp__xcode__XcodeListTestPlans",
      "mcp__xcode__XcodeListTemplates",
      "mcp__xcode__GetTargetBuildSettings",
      "mcp__xcode__GetFileCompilerFlags",
      "mcp__xcode__GetBuildLog",
      "mcp__xcode__GetTestList",
      "mcp__xcode__GetConsoleOutput",
      "mcp__xcode__XcodeRefreshCodeIssuesInFile"
    ],
    "ask": [
      "Bash(git push *)",
      "mcp__xcode__BuildProject",
      "mcp__xcode__RunAllTests",
      "mcp__xcode__RunSomeTests",
      "mcp__xcode__RenderPreview",
      "mcp__xcode__RunProject",
      "mcp__xcode__StopProject",
      "mcp__xcode__RunCodeSnippet",
      "mcp__xcode__InvokeDebuggerCommand",
      "mcp__xcode__DeviceInteractionStartSession",
      "mcp__xcode__DeviceInteractionStartWorkspaceSession",
      "mcp__xcode__DeviceInteractionInstallAndRun",
      "mcp__xcode__DeviceInteractionSynthesize",
      "mcp__xcode__DeviceInteractionEndSession",
      "mcp__xcode__XcodeSwitchScheme",
      "mcp__xcode__XcodeSwitchRunDestination",
      "mcp__xcode__XcodeSwitchTestPlan",
      "mcp__xcode__StringCatalogRead",
      "mcp__xcode__StringCatalogContext",
      "mcp__xcode__GetTopCrashIssues",
      "mcp__xcode__GetCrashIssueLogs",
      "mcp__xcode__GetTopFieldPerformanceIssues",
      "mcp__xcode__GetFieldPerformanceIssueLogs"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git reset --hard *)",
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Edit(/**/*.xcodeproj/**)",
      "Edit(/**/*.xcworkspace/**)",
      "Edit(/.git/**)",
      "mcp__pencil",
      "mcp__xcode__XcodeWrite",
      "mcp__xcode__XcodeUpdate",
      "mcp__xcode__XcodeMakeDir",
      "mcp__xcode__XcodeMV",
      "mcp__xcode__XcodeRM",
      "mcp__xcode__XcodeNewProject",
      "mcp__xcode__XcodeNewTarget",
      "mcp__xcode__AddEntitlement",
      "mcp__xcode__AddInfoPlist",
      "mcp__xcode__UpdateTargetBuildSetting",
      "mcp__xcode__UpdateFileCompilerFlags",
      "mcp__xcode__StringCatalogEdit",
      "mcp__xcode__LocalizationPlanner"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/spec-approval-guard.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-commands.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/secrets-commit-guard.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/spec-approval-guard.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/constitution-lint.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-build-gate.sh", "timeout": 900 }
        ]
      }
    ]
  }
}
