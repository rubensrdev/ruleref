{
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(./init.sh)",
      "Bash(./init.sh *)",
      "Bash(xcodebuild -list *)",
      "Bash(xcodebuild build *)",
      "Bash(xcodebuild test *)",
      "Bash(xcodebuild build-for-testing *)",
      "Bash(xcodebuild test-without-building *)",
      "Bash(xcrun simctl list *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "mcp__cupertino__*"
    ],
    "ask": [
      "Bash(git push *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git reset --hard *)",
      "Read(/**/.env)",
      "Read(/**/.env.*)",
      "Edit(/**/*.xcodeproj/**)",
      "Edit(/**/*.xcworkspace/**)",
      "Edit(/.git/**)",
      "mcp__pencil"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/protect-files.sh" }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-dangerous-commands.sh" },
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/secrets-commit-guard.sh" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/constitution-lint.sh" }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/stop-build-gate.sh", "timeout": 900 }
        ]
      }
    ]
  }
}
