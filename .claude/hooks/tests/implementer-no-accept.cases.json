  { "name": "block Edit f90 to accepted without spaces", "expected_exit": 2,
    "input": { "tool_name": "Edit", "tool_input": { "file_path": ".claude/hooks/tests/fixtures/feature_list.json", "old_string": "\"status\": \"passing\"", "new_string": "\"status\":\"accepted\"" } } },
  { "name": "block Edit replace_all passing to accepted", "expected_exit": 2,
