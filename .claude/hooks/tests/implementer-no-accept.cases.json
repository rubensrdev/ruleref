  { "name": "block Write of broken JSON with one more accepted", "expected_exit": 2,
    "input": { "tool_name": "Write", "tool_input": { "file_path": ".claude/hooks/tests/fixtures/feature_list.json", "content": "[\n  {\n    \"id\": \"f90-sample-open\",\n    \"title\": \"Sample open feature\",\n    \"status\": \"passing\"\n  },\n  {\n    \"id\": \"f91-sample-done\",\n    \"title\": \"Sample done feature\",\n    \"status\": \"accepted\"\n  },\n  {\n    \"id\": \"f92-sample-extra\",\n    \"status\": \"accepted\"\n" } } },
  { "name": "block sed -i", "command": "sed -i '' 's/passing/accepted/' feature_list.json", "expected_exit": 2 },
